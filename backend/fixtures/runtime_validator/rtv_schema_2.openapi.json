{
  "openapi": "3.0.0",
  "info": {
    "title": "Fabrikam · B2B Partner Hub API",
    "version": "1.0.0",
    "description": "Channel partner onboarding and portal settings (demo: runtime validation all green)."
  },
  "paths": {
    "/fabrikam/partners/v1/heartbeat": {
      "get": {
        "summary": "Partner portal liveness probe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["pong", "ts"],
                  "properties": {
                    "pong": { "type": "boolean" },
                    "ts": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fabrikam/partners/v1/directory/search": {
      "get": {
        "summary": "Search partner directory",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["query", "hits"],
                  "properties": {
                    "query": { "type": "string" },
                    "hits": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fabrikam/partners/v1/programs/{programCode}": {
      "get": {
        "summary": "Partner incentive program details",
        "parameters": [
          {
            "name": "programCode",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["slug", "count"],
                  "properties": {
                    "slug": { "type": "string" },
                    "count": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fabrikam/partners/v1/invitations": {
      "post": {
        "summary": "Send co-sell invitation email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "note": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["email", "sent"],
                  "properties": {
                    "email": { "type": "string" },
                    "sent": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fabrikam/partners/v1/settings/ui": {
      "put": {
        "summary": "Replace UI preferences",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["theme"],
                "properties": {
                  "theme": { "type": "string" },
                  "density": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["theme", "density"],
                  "properties": {
                    "theme": { "type": "string" },
                    "density": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Partially update UI preferences",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "theme": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["theme"],
                  "properties": {
                    "theme": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fabrikam/partners/v1/usage/monthly-series": {
      "get": {
        "summary": "Monthly API usage by partner",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["series"],
                  "properties": {
                    "series": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["day", "value"],
                        "properties": {
                          "day": { "type": "string", "format": "date" },
                          "value": { "type": "number" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fabrikam/partners/v1/session": {
      "delete": {
        "summary": "End partner SSO session",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ended"],
                  "properties": {
                    "ended": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
