{
  "openapi": "3.0.0",
  "info": {
    "title": "Northwind Traders · Product Catalog API",
    "version": "1.0.0",
    "description": "Retail product catalog and merchandising surface (demo: runtime validation all green)."
  },
  "paths": {
    "/northwind/catalog/v1/health": {
      "get": {
        "summary": "Catalog service health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "service"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "service": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/northwind/catalog/v1/products": {
      "get": {
        "summary": "List catalog products",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items"],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["id", "name"],
                        "properties": {
                          "id": { "type": "integer" },
                          "name": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/northwind/catalog/v1/products/{productId}": {
      "get": {
        "summary": "Get product by ID",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "name"],
                  "properties": {
                    "id": { "type": "integer" },
                    "name": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/northwind/catalog/v1/promotions": {
      "post": {
        "summary": "Create in-store promotion",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": { "type": "string" },
                  "priority": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "title"],
                  "properties": {
                    "id": { "type": "integer" },
                    "title": { "type": "string" },
                    "priority": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/northwind/catalog/v1/promotions/{promotionId}": {
      "put": {
        "summary": "Update promotion copy",
        "parameters": [
          {
            "name": "promotionId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "title"],
                  "properties": {
                    "id": { "type": "integer" },
                    "title": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/northwind/catalog/v1/feature-flags": {
      "patch": {
        "summary": "Update storefront feature flags",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "darkMode": { "type": "boolean" },
                  "beta": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["darkMode", "beta"],
                  "properties": {
                    "darkMode": { "type": "boolean" },
                    "beta": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/northwind/catalog/v1/sales-summary": {
      "get": {
        "summary": "Regional sales rollup",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["totals"],
                  "properties": {
                    "totals": {
                      "type": "object",
                      "required": ["count", "rate"],
                      "properties": {
                        "count": { "type": "integer" },
                        "rate": { "type": "number" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/northwind/catalog/v1/products/bulk-resolve": {
      "post": {
        "summary": "Resolve many product IDs at once",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ids"],
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": { "type": "integer" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["processed", "ids"],
                  "properties": {
                    "processed": { "type": "integer" },
                    "ids": {
                      "type": "array",
                      "items": { "type": "integer" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
