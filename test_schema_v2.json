{
  "openapi": "3.0.0",
  "info": {
    "title": "Test API v2",
    "version": "2.0.0",
    "description": "Test API for schema diffing - updated"
  },
  "paths": {
    "/users": {
      "get": {
        "summary": "Get users with pagination",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Number of users to return (now string type)"
          },
          {
            "name": "offset",
            "in": "query", 
            "required": false,
            "type": "integer",
            "description": "Number of users to skip - updated description"
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "New filter parameter"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response - updated",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {"type": "integer"},
                  "name": {"type": "string"},
                  "email": {"type": "string"},
                  "age": {"type": "integer"}
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create user with validation",
        "parameters": [
          {
            "name": "user_data",
            "in": "body",
            "required": false,
            "schema": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "email": {"type": "string"},
                "phone": {"type": "string"}
              },
              "required": ["name"]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "User created successfully",
            "schema": {
              "type": "object",
              "properties": {
                "id": {"type": "integer"},
                "name": {"type": "string"},
                "email": {"type": "string"},
                "phone": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
