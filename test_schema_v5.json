{
  "openapi": "3.0.0",
  "info": {
    "title": "Test API v5",
    "version": "5.0.0",
    "description": "Test API for schema diffing - with response schema changes"
  },
  "paths": {
    "/users": {
      "get": {
        "summary": "Get users with pagination",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Number of users to return (now string type)"
          },
          {
            "name": "offset",
            "in": "query", 
            "required": false,
            "type": "integer",
            "description": "Number of users to skip - updated description"
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": ["active", "inactive", "suspended"],
            "default": "active",
            "description": "New filter parameter with enum and default"
          },
          {
            "name": "sort",
            "in": "header",
            "required": false,
            "type": "string",
            "enum": ["name", "email", "created_at"],
            "description": "New header parameter with enum"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response - updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {"type": "integer"},
                      "name": {"type": "string"},
                      "email": {"type": "string"},
                      "age": {"type": "integer"},
                      "address": {
                        "type": "object",
                        "properties": {
                          "street": {"type": "string"},
                          "city": {"type": "string"},
                          "country": {"type": "string"},
                          "zipcode": {"type": "string"}
                        },
                        "required": ["street", "city"]
                      },
                      "created_at": {"type": "string", "format": "date-time"}
                    },
                    "required": ["id", "name", "email"]
                  }
                }
              }
            },
            "headers": {
              "X-Total-Count": {
                "description": "Total number of users",
                "schema": {"type": "integer"}
              },
              "X-Page-Size": {
                "description": "Page size",
                "schema": {"type": "integer"}
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {"type": "string"},
                    "details": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create user with validation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {"type": "string"},
                  "email": {"type": "string"},
                  "phone": {"type": "string"},
                  "age": {"type": "integer"},
                  "address": {
                    "type": "object",
                    "properties": {
                      "street": {"type": "string"},
                      "city": {"type": "string"},
                      "country": {"type": "string"}
                    },
                    "required": ["street", "city"]
                  }
                },
                "required": ["name", "email", "age"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "schema": {
              "type": "object",
              "properties": {
                "id": {"type": "integer"},
                "name": {"type": "string"},
                "email": {"type": "string"},
                "phone": {"type": "string"},
                "age": {"type": "integer"},
                "address": {
                  "type": "object",
                  "properties": {
                    "street": {"type": "string"},
                    "city": {"type": "string"},
                    "country": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
